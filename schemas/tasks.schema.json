{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IFindMe/dev_agent_team/schemas/tasks.schema.json",
  "title": "Dev Agent Team workflow task state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "goal", "status", "created_at", "updated_at", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "goal": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "completed", "blocked", "cancelled"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "objective", "status", "owner", "depends_on", "scope", "inputs", "expected_output", "verification", "report_path", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "queued", "running", "waiting_agent", "waiting_tool", "waiting_verification", "blocked", "repairing", "completed", "failed", "cancelled"] },
        "owner": { "enum": ["architect", "builder", "designer", "detective", "explorer", "maintainer", "orchestrator", "philosopher", "reviewer", "tester", "toolsmith", "tracker", "workflow-architect", "writer"] },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in_scope", "out_of_scope"],
          "properties": {
            "in_scope": { "type": "array", "items": { "type": "string" } },
            "out_of_scope": { "type": "array", "items": { "type": "string" } }
          }
        },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "expected_output": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "report_path": { "type": "string", "pattern": "^\\.opencode/reports/[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[a-z][a-z-]*-agent-[A-Za-z0-9][A-Za-z0-9._-]{0,63}-.+\\.md$" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
